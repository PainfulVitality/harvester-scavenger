<div class="harvest-chat-card harvest-receipt" data-outcome="{{outcome}}" data-has-items="{{#if items.length}}true{{else}}false{{/if}}">
  <div class="harvest-chat-card-title">
    <p>
      <img src="{{source.img}}" data-tooltip="{{source.name}}" alt="{{source.name}}" height="32">
      <i class="fa-solid fa-arrow-right" inert></i>
      <img src="{{actor.img}}" data-tooltip="{{actor.name}}" alt="{{actor.name}}" height="32">
    </p>
    <p>{{message}}</p>
  </div>
  {{#if items.length}}
  <ul>
    {{#each items}}
    <li><img src="{{img}}" alt="" height="16">
      {{#if uuid}}<a class="content-link" data-link data-uuid="{{uuid}}">{{name}}</a>{{else}}<label>{{name}}</label>{{/if}}
      <small>×{{quantity}}</small>
    </li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if effectOccurred}}<p>Something happens.</p>{{/if}}
  {{#if empty}}<p>No items recovered.</p>{{/if}}
</div>
